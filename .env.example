# Copie para .env e ajuste:  cp .env.example .env

# Chave para assinar os tokens de login. Deixe comentada para a API gerar uma sozinha (fica em data/secret_key)
# ou defina uma com:  openssl rand -hex 32   (a API não sobe com chave curta ou de exemplo)
# SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=720
# Custo do hash de senha (bcrypt). 10 = ~0,4 s por login no Pi 3; 12 = ~1,5 s.
BCRYPT_ROUNDS=10

# Administrador criado automaticamente na PRIMEIRA inicialização (banco vazio).
# Esta senha é provisória: o primeiro login obriga a definir outra (mínimo de 10 caracteres).
ADMIN_NOME=Administrador
ADMIN_EMAIL=admin@local
ADMIN_PASSWORD=admin123

# Portas expostas no Raspberry Pi. O HTTPS liga sozinho depois de rodar scripts/configurar-https.sh
HTTP_PORT=80
HTTPS_PORT=443
# 1 = API também por http:// (app Android antigo); 0 = só HTTPS (depois de atualizar o app)
API_HTTP_LEGADO=1

# Login: tentativas com senha errada antes de bloquear o e-mail, e por quantos minutos
TENTATIVAS_LOGIN=5
BLOQUEIO_LOGIN_MINUTOS=15
# Documentação interativa da API em /api/docs (só para testes)
API_DOCS=0

# A tabela do INSS é cadastrada pela tela "Tabela do INSS" (não há mais variável para ela).
