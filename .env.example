# Copie para .env e ajuste:  cp .env.example .env

# Chave para assinar os tokens JWT. Gere uma com:  openssl rand -hex 32
SECRET_KEY=troque-por-uma-chave-longa-e-aleatoria
ACCESS_TOKEN_EXPIRE_MINUTES=720
# Custo do hash de senha (bcrypt). 10 = ~0,4 s por login no Pi 3; 12 = ~1,5 s.
BCRYPT_ROUNDS=10

# Administrador criado automaticamente na PRIMEIRA inicialização (banco vazio).
# Troque a senha pela tela "Usuários do sistema" após o primeiro login.
ADMIN_NOME=Administrador
ADMIN_EMAIL=admin@local
ADMIN_PASSWORD=admin123

# Porta HTTP exposta no Raspberry Pi
HTTP_PORT=80

# Tabela progressiva do INSS do empregado: [teto da faixa, alíquota].
# Atualize todo mês de janeiro (o padrão embutido é a tabela de 2025).
# TABELA_INSS_JSON=[["1518.00","0.075"],["2793.88","0.09"],["4190.83","0.12"],["8157.41","0.14"]]
